# Production Dockerfile for Render Web Service (Free Tier Compatible)
FROM node:20-alpine

# Install OpenSSL & libc for Prisma engine compatibility on Alpine
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

# Set DATABASE_URL at build time so prisma generate works
ARG DATABASE_URL=file:/tmp/dev.db
ENV DATABASE_URL=${DATABASE_URL}
ENV NODE_ENV=production
ENV PORT=3001

# Copy package manifests & Prisma schema first (layer cache)
COPY package*.json ./
COPY prisma ./prisma/

# Install ALL dependencies (including devDeps like prisma cli & tsx)
RUN npm install

# Generate Prisma Client
RUN npx prisma generate

# Copy full application source code
COPY . .

EXPOSE 3001

# Launch Render startup script
CMD ["node", "scripts/render-start.js"]
