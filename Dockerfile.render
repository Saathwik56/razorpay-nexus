# Production Dockerfile for Render Web Service
FROM node:20-alpine

# Install OpenSSL & libc for Prisma engine compatibility on Alpine
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

# Set default production environment variables
ENV NODE_ENV=production
ENV PORT=3001
ENV DATABASE_URL="file:./dev.db"

# Copy package manifests & Prisma schema
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies
RUN npm ci

# Copy full application source code (including scripts, tsconfig.json, src)
COPY . .

# Generate Prisma Client for Alpine runtime
RUN npx prisma generate

EXPOSE 3001

# Launch Render startup script (runs DB push, seed, and starts Fastify server)
CMD ["node", "scripts/render-start.js"]
