# Render Free Tier - Minimal, bulletproof Dockerfile
# Strategy: NO prisma generate at build time - everything at startup
FROM node:20-alpine

# Required for Prisma on Alpine
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

# Copy and install deps
COPY package*.json ./
RUN npm install --include=dev

# Copy prisma schema
COPY prisma ./prisma/

# Generate Prisma client (DATABASE_URL is a dummy for build only - never connects)
ENV DATABASE_URL="file:/tmp/dev.db"
RUN npx prisma generate

# Copy rest of source
COPY . .

# Port
EXPOSE 3001

# Startup
CMD ["node", "scripts/render-start.js"]
