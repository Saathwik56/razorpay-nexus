datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Merchant {
  id                      String           @id @default(uuid())
  name                    String
  email                   String           @unique
  businessName            String
  description             String?
  currency                String           @default("INR")
  aiReadinessScore        Int              @default(82)
  razorpayKeyId           String?
  razorpayAccountStatus   String           @default("TEST_MODE_ACTIVE")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  products                Product[]
  orders                  Order[]
  policies                Policy[]
  agentSessions           AgentSession[]
  auditLogs               AuditLog[]
  recommendations         Recommendation[]
  experiments             Experiment[]
  quotes                  Quote[]
}

model Product {
  id             String      @id @default(uuid())
  merchantId     String
  name           String
  slug           String      @unique
  description    String
  category       String
  price          Float
  currency       String      @default("INR")
  inventory      Int         @default(100)
  sku            String      @unique
  imageUrl       String?
  attributes     String      @default("{}") // Store JSON as string
  shippingInfo   String      @default("{}")
  returnPolicy   String      @default("{}")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  merchant       Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  orders    Order[]
}

model Order {
  id              String      @id @default(uuid())
  merchantId      String
  customerId      String?
  razorpayOrderId String?     @unique
  amount          Float
  currency        String      @default("INR")
  status          String      @default("CREATED") // CREATED, AUTHORIZED, CAPTURED, FAILED, EXPIRED, REFUNDED
  source          String      @default("DIRECT")  // DIRECT, AI_BUYER, REVENUE_AGENT, CAMPAIGN, RECOVERY
  agentSessionId  String?
  quoteId         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int      @default(1)
  unitPrice  Float
  discount   Float    @default(0)
  finalPrice Float

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Quote {
  id          String   @id @default(uuid())
  quoteNumber String   @unique // QT-19381
  merchantId  String
  subtotal    Float
  discount    Float    @default(0)
  total       Float
  currency    String   @default("INR")
  itemsJson   String   @default("[]") // Store quote items
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, ACCEPTED, CANCELLED
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Policy {
  id                    String   @id @default(uuid())
  merchantId            String   @unique
  maxAutoTransaction    Float    @default(5000)
  maxAutoDiscount       Float    @default(300)
  maxDiscountPercentage Float    @default(10)
  allowCreateOrder      Boolean  @default(true)
  allowCreatePaymentLink Boolean @default(true)
  allowCapturePayment   Boolean  @default(true)
  allowRefund           Boolean  @default(false)
  allowPriceChange      Boolean  @default(false)
  humanApprovalAbove    Float    @default(5000)
  allowedCategories     String   @default("[\"supplements\",\"gear\",\"nutrition\"]")
  blockedCategories     String   @default("[]")
  maxOrdersPerCustomer  Int      @default(5)
  maxAutoTxPerHour      Int      @default(10)
  allowedCurrency       String   @default("INR")
  merchantMode          String   @default("TEST_ONLY")
  requireUserConsent    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  merchant              Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model AgentSession {
  id         String        @id @default(uuid())
  agentType  String        // BUYER, REVENUE
  merchantId String
  customerId String?
  status     String        @default("ACTIVE")
  intent     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  actions    AgentAction[]
}

model AgentAction {
  id               String       @id @default(uuid())
  sessionId        String
  actionType       String
  input            String       // JSON string
  output           String       // JSON string
  status           String       @default("COMPLETED")
  policyResult     String       // JSON string
  requiresApproval Boolean      @default(false)
  approvedBy       String?
  createdAt        DateTime     @default(now())

  session          AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]
}

model AuditLog {
  id                 String       @id @default(uuid())
  merchantId         String
  sessionId          String?
  actionId           String?
  transactionId      String?
  quoteId            String?
  razorpayOrderId    String?
  paymentId          String?
  actor              String       @default("SYSTEM") // AI_BUYER, USER, POLICY_ENGINE, RAZORPAY, WEBHOOK, STATE_MACHINE
  eventType          String
  actionName         String       @default("EXECUTE")
  description        String
  inputSnapshot      String       @default("{}") // JSON string
  decision           String       // ALLOW, DENY, APPROVAL_REQUIRED, SUCCESS, FAILED
  reason             String
  previousState      String?
  newState           String?
  requestId          String?
  razorpayEntityType String?
  razorpayEntityId   String?
  status             String       @default("SUCCESS")
  createdAt          DateTime     @default(now())

  merchant           Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  action             AgentAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
}

model Recommendation {
  id               String   @id @default(uuid())
  merchantId       String
  type             String   // UPSELL, CROSS_SELL, BUNDLE, CAMPAIGN, RECOVERY, CATALOG
  title            String
  description      String
  estimatedRevenue Float
  confidence       Float
  status           String   @default("PROPOSED") // PROPOSED, ACTIVE, LAUNCHED, DISMISSED
  metadata         String   @default("{}") // JSON string
  createdAt        DateTime @default(now())

  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Experiment {
  id                String   @id @default(uuid())
  merchantId        String
  name              String
  hypothesis        String
  controlConfig     String   @default("{}") // JSON string
  variantConfig     String   @default("{}") // JSON string
  status            String   @default("RUNNING") // RUNNING, COMPLETED, PAUSED
  controlConversion Float    @default(0)
  variantConversion Float    @default(0)
  controlAov        Float    @default(0)
  variantAov        Float    @default(0)
  winner            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id           String    @id @default(uuid())
  eventId      String    @unique // x-razorpay-event-id
  eventType    String
  payload      String    // JSON string
  processed    Boolean   @default(false)
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
}
